# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/festivo_events
MONGODB_URI_TEST=mongodb://localhost:27017/festivo_events_test

# Redis (optional; set REDIS_ENABLED=false to run without it)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRE=7d

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=festivo-events

# Razorpay (online payments are disabled until both keys are set)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
# Dashboard > Webhooks: URL <backend>/api/v1/payments/webhook,
# events payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Marketplace fees (percent)
BOOKING_COMMISSION_PERCENT=15
TICKET_FEE_PERCENT=5

# Email (SendGrid/SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
FROM_EMAIL=noreply@festivo.com
FROM_NAME=Festivo

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# Frontend site(s), comma separated. The first is used in email/invite links;
# all may call the API.
FRONTEND_URL=http://localhost:4200

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id

# Admin Registration Secret (admin registration is disabled if unset)
ADMIN_SECRET=your-admin-secret-key-change-this

# Rate Limiting (requests per IP per 15 minutes)
API_RATE_LIMIT=1000
